{
    "name": "takepart-media/workflows",
    "description": "Editorial workflow engine and CP dashboard for multi-site Statamic projects.",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "statamic-addon",
        "workflow",
        "editorial",
        "approval",
        "translation",
        "laravel"
    ],
    "homepage": "https://github.com/takepart-media/statamic-workflows",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "symfony/workflow": "^7.0",
        "league/html-to-markdown": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "TakepartMedia\\Workflows\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TakepartMedia\\Workflows\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "TAKEPART Media Science + GmbH",
            "email": "it@takepart-media.de",
            "homepage": "https://www.takepart-media.de",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "it@takepart-media.de",
        "issues": "https://github.com/takepart-media/statamic-workflows/issues",
        "source": "https://github.com/takepart-media/statamic-workflows",
        "docs": "https://github.com/takepart-media/statamic-workflows/blob/main/docs/en/README.md"
    },
    "extra": {
        "statamic": {
            "name": "Workflows",
            "description": "Editorial workflow engine and CP dashboard for multi-site Statamic projects."
        },
        "laravel": {
            "providers": [
                "TakepartMedia\\Workflows\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "pest"
    }
}
